{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-bash-issue-create.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create_issue|create_backlog_item|create_ticket|create_story|createIssue|create_task)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-mcp-issue-create.sh"
          }
        ]
      }
    ]
  }
}
